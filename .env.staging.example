# Staging template. These values are set on the staging host / in the
# `staging` GitHub Environment, not committed. Staging mirrors production
# infrastructure but holds only test data.

APP_ENV="staging"
DATABASE_URL="postgresql://ops_tools_staging:<password>@<staging-db-host>:5432/ops_tools_staging?schema=public&sslmode=require"

# Test-mode key only; the client refuses live keys in every environment.
STRIPE_SECRET_KEY="sk_test_..."
