# Development template. Copy to .env for a local checkout.
# Staging and production templates: .env.staging.example, .env.production.example.

APP_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ops_tools_dev?schema=public"

# Optional. A Stripe *test-mode* secret key (sk_test_…). When set, the refunds
# dashboard fetches transactions from Stripe and issues refunds through the
# Stripe API; when unset it falls back to the seeded transactions.
# STRIPE_SECRET_KEY="sk_test_..."
