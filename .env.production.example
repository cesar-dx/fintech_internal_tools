# Production template. These values are set on the production host / in the
# `production` GitHub Environment, not committed. Seeding is refused when
# APP_ENV=production; schema changes are applied with `npm run db:deploy` only.

APP_ENV="production"
DATABASE_URL="postgresql://ops_tools_prod:<password>@<production-db-host>:5432/ops_tools_prod?schema=public&sslmode=require"

# Test-mode key only; the client refuses live keys in every environment.
STRIPE_SECRET_KEY="sk_test_..."
