generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ANALYST
  REVIEWER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      Role      @default(ANALYST)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auditEntries AuditLogEntry[] @relation("AuditActor")
  kycDecisions KycCase[]       @relation("KycDecidedBy")

  @@index([role])
}

enum KycStatus {
  PENDING
  ESCALATED
  APPROVED
  REJECTED
}

enum RiskFlag {
  LOW
  MEDIUM
  HIGH
}

model KycCase {
  id             String    @id @default(cuid())
  reference      String    @unique
  applicantName  String
  applicantEmail String
  dateOfBirth    DateTime
  nationalId     String
  country        String
  address        String
  occupation     String
  submittedAt    DateTime
  riskFlag       RiskFlag
  riskNotes      String
  status         KycStatus @default(PENDING)
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?     @relation("KycDecidedBy", fields: [decidedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, submittedAt])
}

/// Append-only record of every state change. Written by `mutate()` only,
/// in the same transaction as the change it describes.
model AuditLogEntry {
  id         String   @id @default(cuid())
  /// who
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  /// what
  action     String
  /// which record
  entityType String
  entityId   String
  /// why
  reason     String
  /// when
  createdAt  DateTime @default(now())
  metadata   Json?

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
