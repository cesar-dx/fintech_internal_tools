generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ANALYST
  REVIEWER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      Role      @default(ANALYST)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auditEntries     AuditLogEntry[] @relation("AuditActor")
  kycDecisions     KycCase[]       @relation("KycDecidedBy")
  refundsRequested Refund[]        @relation("RefundRequestedBy")
  refundsReviewed  Refund[]        @relation("RefundReviewedBy")

  @@index([role])
}

enum KycStatus {
  PENDING
  ESCALATED
  APPROVED
  REJECTED
}

enum RiskFlag {
  LOW
  MEDIUM
  HIGH
}

model KycCase {
  id             String    @id @default(cuid())
  reference      String    @unique
  applicantName  String
  applicantEmail String
  dateOfBirth    DateTime
  nationalId     String
  country        String
  address        String
  occupation     String
  submittedAt    DateTime
  riskFlag       RiskFlag
  riskNotes      String
  status         KycStatus @default(PENDING)
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?     @relation("KycDecidedBy", fields: [decidedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, submittedAt])
}

enum TransactionStatus {
  SETTLED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// A settled card payment, as it arrives from the processor feed. Amounts are
/// held in minor units so refund arithmetic stays exact.
model Transaction {
  id            String            @id @default(cuid())
  reference     String            @unique
  customerName  String
  customerEmail String
  cardLast4     String
  merchant      String
  description   String
  amountCents   Int
  refundedCents Int               @default(0)
  currency      String            @default("USD")
  occurredAt    DateTime
  status        TransactionStatus @default(SETTLED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  refunds Refund[]

  @@index([occurredAt])
  @@index([customerEmail])
}

enum RefundStatus {
  PENDING_APPROVAL
  ISSUED
  REJECTED
}

/// A refund against a transaction. Refunds over the approval threshold wait in
/// PENDING_APPROVAL until a reviewer decides; smaller ones are issued outright.
model Refund {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  amountCents   Int
  reason        String
  status        RefundStatus @default(PENDING_APPROVAL)
  requestedById String
  requestedBy   User         @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime     @default(now())
  reviewedById  String?
  reviewedBy    User?        @relation("RefundReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  issuedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, requestedAt])
  @@index([transactionId])
}

/// Append-only record of every state change. Written by `mutate()` only,
/// in the same transaction as the change it describes.
model AuditLogEntry {
  id         String   @id @default(cuid())
  /// who
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  /// what
  action     String
  /// which record
  entityType String
  entityId   String
  /// why
  reason     String
  /// when
  createdAt  DateTime @default(now())
  metadata   Json?

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
